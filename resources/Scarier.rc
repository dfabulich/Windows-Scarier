#include "resource.h"
#include <afxres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)

IDI_SCARIER   ICON        "scarier.ico"
IDR_MANIFEST  RT_MANIFEST "Scarier.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,5,0,0
 PRODUCTVERSION 1,5,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Scarier ADRIFT Interpreter"
      VALUE "FileVersion", "1.5.0"
      VALUE "InternalName", "Scarier"
      VALUE "OriginalFilename", "Scarier.exe"
      VALUE "ProductName", "Scarier for Windows Glk"
      VALUE "ProductVersion", "1.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

/* Windows Glk is linked statically, so its resources go in Scarier.exe too.
   Glk.rc's version resource describes Glk.dll, so rename it to keep Windows
   from showing it as Scarier's version. */
#undef VS_VERSION_INFO
#define VS_VERSION_INFO GLK_VERSION_INFO
#include "Glk.rc"
